# NOTE: BMC (depth 60): the harness is rondo_dev with the layers abstracted (formal/rondo_layers_abs.v).
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 60
cover: mode cover
cover: depth 60

[engines]
smtbmc yices

[script]
read_verilog -sv -formal -DFORMAL dev_bus_f.v rondo_layers_abs.v rondo_dev.v rondo_tile.v rondo_tbuf.v rondo_ps.v rondo_regs.v rondo_seq.v rondo_cksum.v rondo_wmem.v rondo_wpack.v rondo_sram_sp.v rondo_rbus_arb.v rondo_dbgmux.v rondo_trace.v rondo_kat.v rondo_sva_rbus.v rondo_sva_seq.v
prep -top dev_bus_f
async2sync

