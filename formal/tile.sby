# NOTE: BMC depth 60 (bounded; k-induction would need invariants over the tile FSM counters)
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 60
cover: mode cover
cover: depth 60

[engines]
smtbmc yices

[script]
read_verilog -sv -formal -DFORMAL tile_f.v rondo_tile.v
prep -top tile_f
async2sync

[files]
tile_f.v
../rtl/chip/rondo_tile.v
