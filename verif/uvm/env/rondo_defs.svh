// Register map and constants (host/rondo_host/regmap.py is the source; spec section 6/7).
localparam bit [7:0] R_CHIP_ID=8'h00, R_VERSION=8'h01, R_CAPS=8'h02, R_GEOM0=8'h03, R_GEOM1=8'h04, R_GEOM2=8'h05, R_GEOM3=8'h06,
  R_EPS_BF16=8'h07, R_EPS_FP32=8'h08, R_SCRATCH=8'h09, R_CTRL=8'h0A, R_STATUS=8'h0B, R_IRQ_STATUS=8'h0C, R_IRQ_EN=8'h0D, R_ERR_STATUS=8'h0E,
  R_ERR_MASK=8'h0F, R_FORMAT=8'h10, R_XSEL=8'h11, R_SR_N=8'h12, R_SR_COUNT=8'h13, R_WDOG=8'h14, R_LANE_EN=8'h15, R_CLK_CFG=8'h16,
  R_CLKOUT_CFG=8'h17, R_PWR_CTRL=8'h18, R_SPI_CFG=8'h19, R_LAST_CYCLES=8'h20, R_INFER_LO=8'h21, R_INFER_HI=8'h22, R_BUSY_LO=8'h23,
  R_BUSY_HI=8'h24, R_TOTAL_LO=8'h25, R_TOTAL_HI=8'h26, R_SR_CYC_LO=8'h27, R_SR_CYC_HI=8'h28, R_SR_DONE=8'h29, R_CHECKSUM=8'h2A,
  R_SR_PASS=8'h2B, R_LOAD_CRC=8'h2C, R_GUARD=8'h2D, R_NANINF=8'h2E, R_DBG_SEL=8'h30, R_DBG_DATA=8'h31, R_TRC_CFG=8'h38, R_TRC_TRIG=8'h39,
  R_TRC_STATUS=8'h3A, R_ST_STATUS=8'h40, R_KAT_SIG_B=8'h41, R_KAT_SIG_F=8'h42, R_KAT_GOT_B=8'h43, R_KAT_GOT_F=8'h44, R_MB_STATUS=8'h48,
  R_MB_FADDR=8'h49, R_MB_FXOR=8'h4A, R_TILE_CFG=8'h50, R_TILE_STATUS=8'h51, R_TILE_CRC=8'h52, R_TILE_GEOM=8'h53, R_TILE_SLICE=8'h54;
localparam int CT_START=0, CT_SOFT_RST=1, CT_SR_START=2, CT_SR_STOP=3, CT_CNT_CLR=4, CT_CKSUM_CLR=5, CT_CRC_CLR=6, CT_KAT_START=7, CT_MBIST_START=8,
  CT_TRC_ARM=9, CT_TRC_FORCE=10, CT_DBG_LATCH=11, CT_GUARD_CLR=12, CT_TILE_RUN=13, CT_TILE_ABORT=14;
localparam int ER_BUSY_WR=0, ER_ADDR=1, ER_RO=2, ER_START_BUSY=3, ER_PARTIAL=4, ER_RANGE=5, ER_SPI_FRAME=6, ER_WDOG=7, ER_NAN_INF=8, ER_GUARD=9,
  ER_SPI_CRC=10, ER_KAT_FAIL=11, ER_MBIST_FAIL=12, ER_WSTALE_RUN=13, ER_TILE_SEQ=14, ER_TILE_STALE=15;
localparam bit [23:0] XBUF_BASE=24'h010000, ZBUF_BASE=24'h020000, TRACE_BASE=24'h030000, TX_BASE=24'h040000, TZ_BASE=24'h050000, PS_BASE=24'h060000,
  BIAS_BASE=24'h100000, WEIGHT_BASE=24'h800000;
